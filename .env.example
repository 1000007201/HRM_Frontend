# Template for .env — copy to .env and fill in. Never commit .env itself.
# Only VITE_-prefixed vars reach the client, so nothing secret belongs here.

# Base URL of the HRM backend API (separate repo). Must match the backend's
# PORT / BETTER_AUTH_URL, and this app's origin must be in the backend's
# FRONTEND_ORIGIN for cookies to ride along.
VITE_API_BASE_URL=http://localhost:4000

# Dev-only gate for /register-company while the backend's
# ENABLE_PUBLIC_SIGNUP=false. Must match the backend's REGISTRATION_SECRET.
VITE_REGISTRATION_SECRET=
